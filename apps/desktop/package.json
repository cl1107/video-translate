{
  "name": "video-translate",
  "displayName": "视频翻译助手",
  "version": "0.8.2",
  "private": true,
  "description": "基于 sherpa-onnx（SenseVoice/Fun-ASR-Nano）+ Ollama 的本地视频翻译软件",
  "homepage": "https://github.com/cl1107/video-translate",
  "license": "MIT",
  "author": {
    "name": "Video Translate Team",
    "email": "contact@videotranslate.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cl1107/video-translate.git"
  },
  "main": "./node_modules/.dev/main/index.js",
  "scripts": {
    "start": "electron-vite preview",
    "predev": "run-s clean:dev",
    "dev": "cross-env NODE_ENV=development electron-vite dev --watch",
    "compile:app": "electron-vite build",
    "compile:packageJSON": "tsx ./src/lib/electron-app/release/modules/prebuild.ts",
    "prebuild": "run-s clean:dev compile:app compile:packageJSON",
    "prepare:ffmpeg": "node scripts/prepare-bundled-ffmpeg.cjs",
    "build": "pnpm run prepare:ffmpeg && pnpm run rebuild:native && electron-builder",
    "build:ci": "pnpm run prepare:ffmpeg && pnpm run rebuild:native && electron-builder --publish never",
    "build:bundled": "cross-env BUNDLE_FFMPEG=1 pnpm run build",
    "build:slim": "cross-env BUNDLE_FFMPEG=0 pnpm run build",
    "install:desktop": "../../scripts/install-desktop.sh",
    "install:local": "../../scripts/install-desktop.sh",
    "postinstall": "run-s prebuild rebuild:native",
    "install:deps": "electron-builder install-app-deps",
    "rebuild:native": "electron-rebuild --force --only better-sqlite3",
    "make:release": "tsx ./src/lib/electron-app/release/modules/release.ts",
    "release": "pnpm run prepare:ffmpeg && pnpm run rebuild:native && electron-builder --publish always",
    "clean:dev": "rimraf ./node_modules/.dev",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:system-check": "vitest run src/main/utils/system-check.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dayjs": "^1.11.23",
    "openai": "^7.43.0",
    "sherpa-onnx-node": "2.0.0"
  },
  "devDependencies": {
    "7zip-bin": "^5.2.0",
    "@base-ui/react": "^1.9.0",
    "@electron/rebuild": "^4.2.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "code-inspector-plugin": "^2.0.9",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-extension-installer": "^2.0.3",
    "electron-router-dom": "^2.1.1",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.61.0",
    "node-abi": "^4.40.0",
    "npm-run-all2": "^9.0.4",
    "open": "^11.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "rimraf": "^6.1.3",
    "rollup-plugin-inject-process-env": "^1.3.1",
    "semver": "^7.8.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "desktopName": "video-translate.desktop",
  "resources": "src/resources"
}
