{
  "name": "video-translate-monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --filter=@video-translate/landing",
    "dev:desktop": "nsh run apps/nsh",
    "dev:desktop:electron": "pnpm --filter video-translate dev",
    "dev:landing": "pnpm --filter @video-translate/landing dev",
    "build": "turbo run build --filter=@video-translate/landing",
    "build:desktop": "nsh check apps/nsh && nsh package apps/nsh --target macos",
    "build:desktop:electron": "pnpm --filter video-translate build",
    "build:landing": "pnpm --filter @video-translate/landing build",
    "lint": "turbo run lint && oxlint tests",
    "lint:fix": "turbo run lint:fix && oxlint --fix tests",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "turbo run typecheck",
    "test": "nsh test apps/nsh && vitest run tests && turbo run test",
    "test:nsh": "nsh test apps/nsh",
    "test:watch": "vitest tests",
    "start:desktop": "nsh run apps/nsh",
    "preview:landing": "pnpm --filter @video-translate/landing preview",
    "install:desktop": "./scripts/install-desktop.sh",
    "install:local": "./scripts/install-desktop.sh",
    "release": "pnpm --filter video-translate release",
    "make:release": "pnpm --filter video-translate make:release"
  },
  "devDependencies": {
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "turbo": "^2.11.10",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.17.0"
}
